# 环境变量配置模板
# 复制此文件为 .env 并根据需要修改配置

# API 配置
# 基础 URL（可选，默认: http://localhost:3001）
EXPO_PUBLIC_BASE_URL=http://localhost:3001

# API 基础 URL（可选，默认: http://localhost:3001/api）
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api

# 环境配置（可选，默认: development）
EXPO_PUBLIC_NODE_ENV=development

# API 超时时间（可选，默认: 10000 毫秒）
EXPO_PUBLIC_API_TIMEOUT=10000

# 应用配置（可选）
APP_NAME=Expo Base
APP_VERSION=1.0.0

# 示例配置：
# 开发环境
# EXPO_PUBLIC_BASE_URL=http://localhost:3001
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api
# EXPO_PUBLIC_NODE_ENV=development

# 生产环境
# EXPO_PUBLIC_BASE_URL=https://your-production-domain.com
# EXPO_PUBLIC_API_BASE_URL=https://your-production-domain.com/api
# EXPO_PUBLIC_NODE_ENV=production

# 测试环境
# EXPO_PUBLIC_BASE_URL=http://test-server:3001
# EXPO_PUBLIC_API_BASE_URL=http://test-server:3001/api
# EXPO_PUBLIC_NODE_ENV=test
