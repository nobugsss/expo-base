# ===========================================
# Expo Base 应用环境变量配置模板
# ===========================================
# 
# 使用说明：
# 1. 此文件包含环境变量配置模板和详细说明
# 2. 如需本地个性化配置，请创建 .env.local 文件
# 3. .env.local 文件已被 .gitignore 忽略，不会提交到版本控制
#

# ===========================================
# API 服务器配置
# ===========================================

# 基础 URL
# 开发环境：使用本机IP地址（移动端可访问）
# 生产环境：使用域名
# 获取本机IP: ifconfig | grep "inet " | grep -v 127.0.0.1
EXPO_PUBLIC_BASE_URL=http://192.168.1.5:3000

# API 基础 URL
# 通常为基础 URL + /api
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:3000/api

# ===========================================
# 应用配置
# ===========================================

# 环境类型
# 可选值: development, test, production
EXPO_PUBLIC_NODE_ENV=development

# API 请求超时时间（毫秒）
# 建议值: 5000-15000
EXPO_PUBLIC_API_TIMEOUT=10000

# ===========================================
# 环境配置示例
# ===========================================

# ===========================================
# 本地个性化配置示例 (.env.local)
# ===========================================
# 
# 如需本地个性化配置，请创建 .env.local 文件，内容示例：
#
# # 本地开发环境（使用本机IP）
# EXPO_PUBLIC_BASE_URL=http://192.168.1.5:3000
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:3000/api
# EXPO_PUBLIC_NODE_ENV=development
# EXPO_PUBLIC_API_TIMEOUT=10000
#
# # 生产环境示例
# EXPO_PUBLIC_BASE_URL=https://api.yourdomain.com
# EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api
# EXPO_PUBLIC_NODE_ENV=production
# EXPO_PUBLIC_API_TIMEOUT=15000
#
# # 测试环境示例
# EXPO_PUBLIC_BASE_URL=http://test-server:3000
# EXPO_PUBLIC_API_BASE_URL=http://test-server:3000/api
# EXPO_PUBLIC_NODE_ENV=test
# EXPO_PUBLIC_API_TIMEOUT=8000